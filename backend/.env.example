# ===== Postgres (service name "postgres" from docker-compose) =====
POSTGRES_PASSWORD=CHANGE_ME_STRONG
DATABASE_URL=postgresql+asyncpg://rag:CHANGE_ME_STRONG@postgres:5432/ragdb

# ===== MySQL tender DB (now hosted inside docker-compose as service "mysql") =====
MYSQL_ROOT_PASSWORD=CHANGE_ME_STRONG
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=tender
MYSQL_PASSWORD=CHANGE_ME_STRONG
MYSQL_DB=probid
TENDER_RESULT_LIMIT=10
TENDER_ENABLED=true

# ===== LLM (Groq — free tier, OpenAI-compatible) =====
# Create a free key at https://console.groq.com/keys
LLM_API_KEY=gsk_...
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=qwen/qwen3.8-27b
LLM_MODEL_FAST=qwen/qwen3.8-27b
LLM_CTX=6144
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=320

# ===== Embeddings =====
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_MAX_LEN=1024

# ===== Reranker =====
RERANK_MODEL=BAAI/bge-reranker-base
RERANK_MAX_LEN=512

# ===== Retrieval =====
TOP_K_DENSE=25
TOP_K_SPARSE=25
TOP_K_HYBRID=12
TOP_K_RERANK=4
RRF_K=60
HNSW_EF_SEARCH=80

# ===== Cache (docker service "redis") =====
REDIS_URL=redis://redis:6379/0
CACHE_TTL=3600

# ===== Auth — CHANGE THIS =====
ADMIN_TOKEN=CHANGE_ME_TOKEN
# Live origin(s) allowed to call the API (the websites that embed the widget)
CORS_ORIGINS=https://your-live-domain.com

# ===== Models cache (inside container) =====
HF_HOME=/app/models
TRANSFORMERS_CACHE=/app/models